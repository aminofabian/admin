# API Configuration
# Set this to your backend API URL
NEXT_PUBLIC_API_URL=https://api.serverhub.biz

# Project Domain for automatic UUID fetching
NEXT_PUBLIC_PROJECT_DOMAIN=https://serverhub.biz

# Development example:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_PROJECT_DOMAIN=http://localhost:3000

# Production example:
# NEXT_PUBLIC_API_URL=https://admin.serverhub.biz
# NEXT_PUBLIC_PROJECT_DOMAIN=https://serverhub.biz

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Jev judgment layer (https://www.jevai.org) — create a key at https://www.jevai.org/agent/keys
# Used server-side to gate consequential transaction actions. Never commit a real key.
